<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- La camara Theta se lee por ImageCaptureCore (PTP por USB) y macOS lo trata como acceso a
         la camara (permiso de TCC). Con hardened runtime, sin este entitlement el pedido se
         niega sin mostrar el cartel. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
